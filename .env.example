NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Database connection — use either DATABASE_URL or the individual DB_* variables
# Option A: connection string (preferred for cloud providers like Aiven)
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?ssl-mode=REQUIRED

# Option B: individual credentials
DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Set to false only if your DB host uses a self-signed cert (not recommended in production)
DB_SSL_REJECT_UNAUTHORIZED=true

# Production/Aiven only: paste the CA certificate PEM with newlines escaped as \n
DB_SSL_CA=

# Session secret — must be at least 32 random characters in production
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Admin seeding (only used by: npm --prefix backend run seed:admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password_min_12_chars
